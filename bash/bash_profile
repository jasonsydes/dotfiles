# bash_profile is for interactive shells

# Source the (non-interactive) ~/.bashrc.
if [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi

# $DOTFILES is set inside ~/.bashrc. Warn (in interactive mode only) if it is not set.
if [ -n "${DOTFILES:-}" ]; then
    # Source the main interactive file
    source $DOTFILES/all/main-interactive
else
    # DOTFILES is not set or empty; go fix it.
    echo 'ERROR: $DOTFILES is not set! Things are likely very broken.'
fi
