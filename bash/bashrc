# bashrc is for "interactive non-login" shells -- a new tmux pane, `bash` from
# inside another shell, a subshell. It is ALSO sourced by ~/.bash_profile, so
# interactive login shells run it too. Finally, we have
# "non-interactive-ssh+ext" shells (scp, sftp, `ssh host cmd`, `bash -lc`) as
# well.
#
# WHY THIS FILE (~/.bashrc) IS SPLIT IN TWO
#
#   The top half (eg PATH and env stuff) is read by all three:
#   - interactive non-login
#   - interactive login
#   - non-interactive-ssh+ext
#
#   The bottom half is only read by the truly interactive shells. Stuff that
#   prints, text editors, aliases, etc, some of which (eg echo'ing text) breaks
#   things like scp in the non-interactive-ssh+ext group.
#   
#   So: BEFORE the Interactive Guard = all three. AFTER = interactive only.
#
# MORE INFO: bash/README.Interactive-Soup.md -- glossary, the three-zone
# model, the host matrix, and the decision log behind all of it.

# shortcut to this dotfiles path is $DOTFILES
export DOTFILES="$HOME/.dotfiles"

# Track optional tools not found (reported at end of init)
_missing=()

# History env vars, pass 1. Safe to source repeatedly.
source $DOTFILES/bash/history_vars

# /etc/profile workaround - MUST BE (NEARLY) THE FIRST LINE IN THIS FILE!
#
# Briefly: builds a consistent PATH and other important envs on most/all
# platforms. See etc_profile_workaround for details.
#
# DO NOT gate this on `[[ $- == *i* ]]`. Tried 260823, reverted same day --
# it breaks slurm on talapas and duplicates PATH. See etc_profile_workaround.
if [ -f $DOTFILES/etc_profile_workaround ]; then
  source $DOTFILES/etc_profile_workaround
fi

# History env vars, pass 2 — REQUIRED, not redundant.
#
# Because of etc_profile_workaround above, we need to re-source this file
# (otherwise vars like HISTSIZE get reset). See bash/history_vars for details.
source $DOTFILES/bash/history_vars

# History syncing + daily backup. ONCE ONLY, and must come after the workaround
# above. See bash/history_sync for why both of those matter.
source $DOTFILES/bash/history_sync

# Zone A: everything every shell that reads this file needs. Must print nothing.
source $DOTFILES/all/main-common

# Load bash settings.
source $DOTFILES/bash/settings

# Load source files.
shopt -s nullglob
for f in $DOTFILES/*/source $DOTFILES/*/*/source; do source "$f"; done
shopt -u nullglob

# Pixi — must be before starship so pixi-installed tools are in PATH
export PATH="$HOME/.pixi/bin:$PATH"

# ───────────────────────────────────────────────────────────────
# ── THE INTERACTIVE GUARD — interactive shells only, after this ─
#
# non-interactive-ssh+ext shells (scp, sftp, `ssh host cmd`, `bash -lc`) return
# here. They needed the PATH and env set above; they must not see anything
# below, because the scp/sftp protocol runs over stdout and a stray echo
# corrupts transfers. Keep stderr quiet too.
#
# Everything else in the tree refers to this line as BEFORE (above) / AFTER
# (below) the Interactive Guard. Definitions: README.Interactive-Soup.md
[[ $- != *i* ]] && return

# ── AFTER the Interactive Guard: login and non-login alike ─────
# ───────────────────────────────────────────────────────────────

# Lando
# NOTE: This should really just be on laptop only.
export PATH="$HOME/.lando/bin:$PATH" #landopath

# ── Prompt, bash-preexec, and others ───────────────────────────────
#
# LOAD ORDER MATTERS. These must load in this exact sequence:
#
#   1. starship        — Sets up PROMPT_COMMAND to regenerate PS1 each prompt.
#   2. bash-preexec    — Wraps PROMPT_COMMAND and provides precmd_functions
#                        and preexec_functions arrays. Multiple tools can
#                        register hooks without stomping on each other.
#   3. all/main-interactive
#                      — Loads the */interactive fragments, which include
#                        terminal/ghostty/interactive: Ghostty's shell
#                        integration for OSC 133 prompt marking. Only
#                        activates inside tmux. MUST come after bash-preexec
#                        (see the CAVEAT below for what it actually hooks).
#
#   (atuin was step 3 here — DEPRECATED/UNINSTALLED, removed 260509.)
#
# If bash-preexec loads BEFORE starship, they collide (starship prompt
# breaks). Starship must set up PROMPT_COMMAND first, then bash-preexec
# wraps around it. (Discovered 251102.)
#
# What is bash-preexec?
# Bash natively only has PROMPT_COMMAND (runs before each prompt). It has
# no hook for "right before a command executes." bash-preexec adds two
# capabilities:
#   - precmd_functions[]  — array of functions to run before each prompt
#   - preexec_functions[] — array of functions to run before each command
# It works by hijacking PROMPT_COMMAND and the DEBUG trap, so tools can
# coexist without overwriting each other.
#
# CAVEAT (measured 260822, Ghostty 1.3.1): Ghostty does NOT use those arrays
# by default. It appends __ghostty_hook to PROMPT_COMMAND and adds to PS0,
# falling back to precmd_functions only in an else-branch. So the marker to
# grep for is __ghostty_hook in PROMPT_COMMAND:
#     echo "${PROMPT_COMMAND[*]}" | grep -o __ghostty_hook
# Note starship also stashes any pre-existing PROMPT_COMMAND into
# $STARSHIP_PROMPT_COMMAND and evals it from starship_precmd — so things set
# before `starship init` end up there, not in PROMPT_COMMAND itself.
#
# Step 3 below (all/main-interactive) loads terminal/ghostty/interactive,
# which does the sourcing. It only activates inside tmux; outside tmux
# Ghostty auto-injects into the shell it spawns and the fragment is a no-op.

# 1. Starship prompt.
# Yes, inside bashrc ("interactive non-login"), not bash_profile ("interactive login").
# For whatever reason, 'sudo bash' won't load bash_profile, only bashrc.
# But putting the prompt here in bashrc *does* work. 🤷
# And, noted, putting it here doesn't seem to interfere with scp.
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
else
    _missing+=(starship)
fi

# 2. bash-preexec (must be after starship).
[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh

# 3. Zone B: every interactive shell, login and non-login alike.
#    MUST stay after bash-preexec — see the LOAD ORDER MATTERS block above.
#    Loads */aliases and */interactive, incl. terminal/ghostty/interactive.
source $DOTFILES/all/main-interactive

# NOTE: This should probably go somewhere else.
[ -f "$HOME/.bash_completions/gc3f-secrets.sh" ] && source "$HOME/.bash_completions/gc3f-secrets.sh"

# ── Report missing optional tools (interactive only) ───────────────
# Keep this LAST — everything that appends to _missing must run above it.
[[ $- == *i* ]] && (( ${#_missing[@]} )) && \
    echo -e "\e[90mshell: not installed: ${_missing[*]}\e[0m"
unset _missing
