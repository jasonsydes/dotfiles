# bashrc is for "interactive non-login" shells.
#   e.g. a new tmux pane, `bash` run from inside another shell, a subshell.
#
# It is ALSO sourced by ~/.bash_profile, so interactive *login* shells run it
# too — everything here applies to both. Login-only content goes in
# all/main-interactive-login instead.
#
# THE SCP CAVEAT (why the guard below sits where it does):
#   scp/sftp/rsync-over-ssh and `ssh host cmd` are NON-interactive, so by the
#   strict rules they should never read this file. But they DO get a fresh
#   shell, and bash reads ~/.bashrc for them anyway. So this file runs in
#   three cases, not two:
#       1. interactive non-login   (tmux pane, subshell)
#       2. interactive login       (via bash_profile)
#       3. NON-interactive         (scp, sftp, ssh host cmd)
#   Hence the split partway down: everything ABOVE the `[[ $- != *i* ]]`
#   guard runs for all three (PATH, env — scripts need those); everything
#   BELOW runs only for 1 and 2 (prompt, shell integration — these corrupt
#   the sftp protocol if they print).
#
# History note: this file used to be labeled "bashrc is for non-interactive
# shells", which was simply wrong and had propagated into the names of the
# include files. Corrected 260509; see all/main-interactive-{login,non-login}.

# shortcut to this dotfiles path is $DOTFILES
export DOTFILES="$HOME/.dotfiles"

# Track optional tools not found (reported at end of init)
_missing=()

# Let's set infinite history and PROMPT_COMMAND immediately
# (perhaps this will stop the endemic history truncation)
# 251121
source $DOTFILES/bash/history_and_prompt_command

# /etc/profile workaround - MUST BE (NEARLY) THE FIRST LINE IN THIS FILE!
if [ -f $DOTFILES/etc_profile_workaround ]; then
  source $DOTFILES/etc_profile_workaround
fi

# Looks like Talapas /etc/profile modifies HIST env vars, source
# our version again here. 
# (perhaps this will stop the endemic history truncation)
# 251121
source $DOTFILES/bash/history_and_prompt_command

# Never put anything in your bashrc that you don't understand.
# Never put anything in your bashrc that you don't understand.
# Never put anything in your bashrc that you don't understand.

# Zone A: everything every shell that reads this file needs. Must print nothing.
source $DOTFILES/all/main-common

# Load bash settings.
source $DOTFILES/bash/settings

# Load source files.
shopt -s nullglob
for f in $DOTFILES/*/source $DOTFILES/*/*/source; do source "$f"; done
shopt -u nullglob

# Pixi — must be before starship so pixi-installed tools are in PATH
export PATH="$HOME/.pixi/bin:$PATH"

# ───────────────────────────────────────────────────────────────
# ── Non-interactive shells stop here ───────────────────────────

# Return here if non-interactive, continue onwards if interactive.
#
# scp, sftp, rsync, and scripts don't need starship, etc.
# Without this guard, their stderr output corrupts the sftp protocol.
[[ $- != *i* ]] && return

# ── Only interactive (login or non-login) continue onwards ─────
# ───────────────────────────────────────────────────────────────

# Lando
# NOTE: This should really just be on laptop only.
export PATH="$HOME/.lando/bin:$PATH" #landopath

# ── Prompt, bash-preexec, and others ───────────────────────────────
#
# LOAD ORDER MATTERS. These must load in this exact sequence:
#
#   1. starship        — Sets up PROMPT_COMMAND to regenerate PS1 each prompt.
#   2. bash-preexec    — Wraps PROMPT_COMMAND and provides precmd_functions
#                        and preexec_functions arrays. Multiple tools can
#                        register hooks without stomping on each other.
#   3. all/main-interactive
#                      — Loads the */interactive fragments, which include
#                        terminal/ghostty/interactive: Ghostty's shell
#                        integration, hooking bash-preexec's precmd_functions
#                        for OSC 133 prompt marking. Only activates inside
#                        tmux. MUST come after bash-preexec.
#
#   (atuin was step 3 here — DEPRECATED/UNINSTALLED, removed 260509.)
#
# If bash-preexec loads BEFORE starship, they collide (starship prompt
# breaks). Starship must set up PROMPT_COMMAND first, then bash-preexec
# wraps around it. (Discovered 251102.)
#
# What is bash-preexec?
# Bash natively only has PROMPT_COMMAND (runs before each prompt). It has
# no hook for "right before a command executes." bash-preexec adds two
# capabilities:
#   - precmd_functions[]  — array of functions to run before each prompt
#   - preexec_functions[] — array of functions to run before each command
# It works by hijacking PROMPT_COMMAND and the DEBUG trap. Tools like
# atuin, starship, and Ghostty's shell integration all register hooks
# here so they coexist without overwriting each other.
#
# After bashrc finishes, bash_profile sources main-interactive-login, which
# loads terminal/ghostty/interactive-login — that file sources Ghostty's shell
# integration inside tmux, hooking into the same bash-preexec arrays.

# 1. Starship prompt.
# Yes, inside bashrc ("interactive non-login"), not bash_profile ("interactive login").
# For whatever reason, 'sudo bash' won't load bash_profile, only bashrc.
# But putting the prompt here in bashrc *does* work. 🤷
# And, noted, putting it here doesn't seem to interfere with scp.
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
else
    _missing+=(starship)
fi

# 2. bash-preexec (must be after starship).
[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh

# 3. Zone B: every interactive shell, login and non-login alike.
#    MUST stay after bash-preexec — see the LOAD ORDER MATTERS block above.
#    Loads */aliases and */interactive, incl. terminal/ghostty/interactive.
source $DOTFILES/all/main-interactive

# NOTE: This should probably go somewhere else.
[ -f "$HOME/.bash_completions/gc3f-secrets.sh" ] && source "$HOME/.bash_completions/gc3f-secrets.sh"

# ── Report missing optional tools (interactive only) ───────────────
# Keep this LAST — everything that appends to _missing must run above it.
[[ $- == *i* ]] && (( ${#_missing[@]} )) && \
    echo -e "\e[90mshell: not installed: ${_missing[*]}\e[0m"
unset _missing
