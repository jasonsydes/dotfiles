# ZONE B. Sourced from ~/.bashrc, AFTER (below) the Interactive Guard.
#
# Runs for BOTH kinds of interactive shell:
#   interactive login       Ghostty window/tab, new tmux pane, `ssh longreads`
#   interactive non-login   `bash` at a prompt, `sudo bash`, a subshell
#
# Not run for non-interactive-ssh+ext (scp, sftp, `ssh host cmd`, `bash -lc`).
#
# LOAD ORDER: must be sourced after bash-preexec. The */interactive fragments
# include terminal/ghostty/interactive, which needs bash-preexec to exist
# first. See the LOAD ORDER MATTERS block in bash/bashrc before moving it.
#
#   -> "Is it for a human typing at a prompt?"
#      (If nested shells should SKIP it, use all/main-interactive-login.)
#
# MORE INFO: bash/README.Interactive-Soup.md

# ------

# Editor
# Experimental: Trying out a slim nvim config that addresses both general
# purpose editors and claude ctrl-g mode.
export EDITOR='env NVIM_APPNAME=nvim-EDITOR nvim'
export VISUAL="$EDITOR"
# Uncomment below for old school.
# export EDITOR='vim'
# export VISUAL="$EDITOR"

# https://stackoverflow.com/questions/37209913/how-does-alias-sudo-sudo-work
alias sudo='sudo '

# ------

shopt -s nullglob

# Load alias files.
[ -n "${DOTFILES:-}" ] && for f in $DOTFILES/*/aliases $DOTFILES/*/*/aliases ; do source "$f" ; done

# Load files for every interactive shell (login and non-login alike).
[ -n "${DOTFILES:-}" ] && for f in $DOTFILES/*/interactive $DOTFILES/*/*/interactive ; do source "$f" ; done

shopt -u nullglob
