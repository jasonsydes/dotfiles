# ZONE A. Sourced from ~/.bashrc, BEFORE (above) the Interactive Guard.
#
# Runs for every shell that reads ~/.bashrc at all:
#   interactive login          Ghostty window/tab, new tmux pane, `ssh longreads`
#   interactive non-login      `bash` at a prompt, `sudo bash`, a subshell
#   non-interactive-ssh+ext    scp, sftp, `ssh longreads whoami`, `bash -lc`
#
# That last case is why this file exists -- those shells should never read a
# startup file, but do, and they need PATH/env from it or they break. It does
# NOT cover `bash script.sh`, which reads nothing and inherits from its parent.
#
# Must print NOTHING: the scp/sftp protocol runs over stdout.
#
#   -> "Would a remote command or scp break without it?"
#
# MORE INFO: bash/README.Interactive-Soup.md

# ------

## Taken from http://harts.net/reece/setup/bashrc, Thanks!
# This is my attempt to create order from chaos in platform naming
# All info is derived from uname and lowercased.  OS patchlevel is truncated.
export OS=`uname -s | sed -e 's/  */-/g;y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/'`
export OSVERSION=`uname -r`; OSVERSION=`expr "$OSVERSION" : '[^0-9]*\([0-9]*\.[0-9]*\)'`
export MACHINE=`uname -m | sed -e 's/  */-/g;y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/'`
export PLATFORM="$MACHINE-$OS-$OSVERSION"

# ------

# Load path files.
shopt -s nullglob
[ -n "${DOTFILES:-}" ] && for f in $DOTFILES/*/path $DOTFILES/*/*/path ; do source "$f" ; done
shopt -u nullglob
export PATH

# Load host misc files.
shopt -s nullglob
[ -n "${DOTFILES:-}" ] && for f in $DOTFILES/*/misc $DOTFILES/*/*/misc ; do source "$f" ; done
shopt -u nullglob

# ------

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
[ -f ~/.localrc ] && source ~/.localrc
